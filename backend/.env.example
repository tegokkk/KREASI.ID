PORT=3001
QUIZ_MODE=local
QUIZ_FORM_URL=
QUIZ_RETENTION_DAYS=30
BK_CONTACT_URL=

# Authentication and persistent account storage
BETTER_AUTH_URL=http://localhost:3001
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:3001
# Production requires a random secret with at least 32 characters.
# Development generates and stores a secret in backend/data/auth-secret.
BETTER_AUTH_SECRET=
# PostgreSQL is mandatory on Vercel and in production. Keep credentials server-side.
# Copy connection strings from Supabase Connect; HTTPS project URLs are not SQL URLs.
DATABASE_URL=
# Use Direct or Session pooler (5432) for migration; runtime may use Transaction pooler (6543).
DATABASE_MIGRATION_URL=
DATABASE_SCHEMA=kreasi_development
DATABASE_POOL_MAX=3
# Optional replacement CA PEM. Supabase Root 2021 is bundled and hostname verification remains on.
DATABASE_SSL_CA=
# SQLite is used only for local development when DATABASE_URL is absent.
# Optional absolute path; default backend/data/accounts.sqlite. No SQLite fallback in production.
AUTH_DATABASE_PATH=
# Optional environment values for npm run create-superadmin --workspace=backend.
SUPERADMIN_EMAIL=superadmin@kreasi.id
SUPERADMIN_PASSWORD=
# An empty password generates a random password for this one-time bootstrap.

# Do not import this local template to Vercel: run npm run deploy:prepare and use
# backend/.env.preview.local / backend/.env.production.local for their respective targets.
# Vercel derives HTTPS origins from trusted system variables. Set BETTER_AUTH_URL
# and AUTH_TRUSTED_ORIGINS explicitly only if overriding the canonical domain.
